{
  "name": "tianxia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public",
    "check": "node scripts/check.mjs",
    "map:model": "node scripts/build-tang-map-model.mjs && node scripts/build-strategic-geometry.mjs",
    "map:verify": "node scripts/verify-production-map.mjs",
    "test": "node --test",
    "types": "wrangler types worker-configuration.d.ts",
    "types:check": "node scripts/types-check.mjs",
    "desktop:prepare": "node scripts/build-desktop.mjs",
    "qa:playtest": "node scripts/playtest-flow.mjs",
    "desktop:icons": "node scripts/generate-icons.mjs",
    "desktop:check": "node scripts/build-desktop.mjs && node --test tests/desktop.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply GAME_DB --local"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "d3": "^7.9.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
